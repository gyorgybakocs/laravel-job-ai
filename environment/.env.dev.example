APP_NAME=m-int
APP_ENV=local
APP_DEBUG=true
APP_KEY=

APP_DOMAIN=${APP_NAME}-dev.com
APP_SCHEME=http
SESSION_DOMAIN=

NODE_VERSION=22
PHP_VERSION=8.4
POSTGRES_VERSION=15.17
NGINX_VERSION=1.29.5
ADMINER_VERSION=5.4.2
REDIS_VERSION=8.10.2
COMPOSER_VERSION=2
LARAVEL_VERSION=^12.1.2

NODE_DOCKER_IMAGE=node:${NODE_VERSION}-alpine
NODE_IMAGE=${APP_NAME}-${NODE_DOCKER_IMAGE}
NODE_CONTAINER=${APP_NAME}-node
APP_DOCKER_IMAGE=php:${PHP_VERSION}-fpm-alpine
APP_IMAGE=${APP_NAME}-${APP_DOCKER_IMAGE}
APP_CONTAINER=${APP_NAME}-app
COMPOSER_DOCKER_IMAGE=composer:${COMPOSER_VERSION}
COMPOSER_IMAGE=${APP_NAME}-${COMPOSER_DOCKER_IMAGE}
COMPOSER_CONTAINER=${APP_NAME}-composer
POSTGRES_DOCKER_IMAGE=postgres:${POSTGRES_VERSION}
POSTGRES_IMAGE=${APP_NAME}-${POSTGRES_DOCKER_IMAGE}
POSTGRES_CONTAINER=${APP_NAME}-postgres
NGINX_DOCKER_IMAGE=nginx:${NGINX_VERSION}
NGINX_IMAGE=${APP_NAME}-${NGINX_DOCKER_IMAGE}
NGINX_CONTAINER=${APP_NAME}-nginx
ADMINER_DOCKER_IMAGE=adminer:${ADMINER_VERSION}
ADMINER_IMAGE=${APP_NAME}-${ADMINER_DOCKER_IMAGE}
ADMINER_CONTAINER=${APP_NAME}-adminer
REDIS_DOCKER_IMAGE=redis:${REDIS_VERSION}
REDIS_IMAGE=${APP_NAME}-${REDIS_DOCKER_IMAGE}
REDIS_CONTAINER=${APP_NAME}-redis

POSTGRES_DB=${APP_NAME}

DB_CONNECTION=pgsql
DB_HOST=app-postgresql
DB_PORT=5432
DB_DATABASE=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

ADMINER_PORT=8082

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
